<Window x:Class="Decorator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Decorator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="*" MaxHeight="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="*" MaxHeight="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16" Source="images/crepe.png" />
        <Image Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16" Source="images/waffle.png" />
        <RadioButton x:Name="crepe" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <RadioButton x:Name="waffle" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Label Grid.Row="2" Grid.ColumnSpan="2" Content="Supplements :" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
        <Image Grid.Row="3" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16" Source="images/chocolate.png" />
        <Image Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16" Source="images/sugar.png" />
        <CheckBox x:Name="chocolate" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <CheckBox x:Name="sugar" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Button Grid.Row="6" Grid.Column="0" Margin="10" Content="Validate" Click="Validate"/>
        <TextBox x:Name="theText" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" IsReadOnly="True" TextAlignment="Left"/>
    </Grid>
</Window>
